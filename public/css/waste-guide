/* public/css/waste-guide.css */
/* feature/guide 브랜치 담당: 폐기가이드 페이지 스타일 */
/* style.css의 공통 변수 및 레이아웃 클래스를 이어받음 */

/* ===== 안내 배너 ===== */
.guide-notice-banner {
  display: flex;
  align-items: flex-start;
  gap: 16px;
  background-color: #e8f5e9;
  border: 1px solid #c8e6c9;
  border-radius: 12px;
  padding: 16px 20px;
  margin-bottom: 28px;
}

.guide-notice-icon {
  flex-shrink: 0;
  margin-top: 2px;
}

.guide-notice-text strong {
  display: block;
  font-size: 15px;
  font-weight: 600;
  color: #1b5e20;
  margin-bottom: 8px;
}

.guide-notice-text ul {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.guide-notice-text ul li {
  font-size: 13px;
  color: #2e7d32;
  padding-left: 16px;
  position: relative;
}

.guide-notice-text ul li::before {
  content: '◎';
  position: absolute;
  left: 0;
  font-size: 11px;
}

/* ===== 메인 그리드 ===== */
.guide-main-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 28px;
  align-items: start;
}

/* ===== 섹션 제목 ===== */
.guide-section-title {
  font-size: 18px;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 16px;
}

/* ===== 왼쪽 패널: 폐기 방법 카드 ===== */
.guide-left-panel {}

.guide-cards-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
}

.guide-card {
  background: #ffffff;
  border: 1px solid #e8e8e8;
  border-radius: 12px;
  padding: 16px;
  transition: box-shadow 0.2s, transform 0.2s;
}

.guide-card:hover {
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
  transform: translateY(-2px);
}

.guide-card-header {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 12px;
}

.guide-card-icon {
  font-size: 20px;
}

.guide-card-type {
  font-size: 15px;
  font-weight: 600;
  color: #1a1a1a;
}

.guide-card-img-placeholder {
  width: 100%;
  aspect-ratio: 4/3;
  background-color: #f5f5f5;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 10px;
}

/* ⚠️ 팀원 참고: 실제 이미지가 생기면 아래처럼 교체하세요
  .guide-card-img-placeholder img { width: 100%; height: 100%; object-fit: cover; border-radius: 8px; }
*/
.guide-card-img-text {
  font-size: 13px;
  color: #9e9e9e;
}

.guide-card-guide {
  font-size: 13px;
  font-weight: 500;
  color: #333;
  margin-bottom: 6px;
  line-height: 1.5;
}

.guide-card-detail {
  font-size: 12px;
  color: #757575;
  line-height: 1.6;
  display: none; /* 기본 숨김, 향후 토글로 확장 가능 */
}

/* ===== 오른쪽 패널: 지도 ===== */
.guide-right-panel {}

.guide-map-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16px;
}

.guide-map-header .guide-section-title {
  margin-bottom: 0;
}

.btn-find-location {
  display: flex;
  align-items: center;
  gap: 6px;
  background-color: #2e7d32;
  color: #ffffff;
  border: none;
  border-radius: 8px;
  padding: 8px 14px;
  font-size: 13px;
  font-weight: 500;
  cursor: pointer;
  transition: background-color 0.15s, opacity 0.15s;
  white-space: nowrap;
  font-family: inherit;
}

.btn-find-location:hover {
  background-color: #1b5e20;
}

.btn-find-location:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

/* ===== 카카오맵 ===== */
.kakao-map-container {
  width: 100%;
  height: 360px;
  border-radius: 12px;
  overflow: hidden;
  background-color: #f0f0f0;
  margin-bottom: 14px;
}

.map-unavailable {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8px;
  color: #9e9e9e;
  font-size: 14px;
  text-align: center;
}

.map-unavailable span {
  font-size: 40px;
}

.map-unavailable small {
  font-size: 12px;
  color: #bdbdbd;
  line-height: 1.6;
}

/* 내 위치 마커 */
.my-location-marker {
  width: 16px;
  height: 16px;
  border-radius: 50%;
  background-color: #1976d2;
  border: 3px solid #ffffff;
  box-shadow: 0 0 0 3px rgba(25, 118, 210, 0.3);
}

/* 인포윈도우 */
.map-infowindow {
  padding: 10px 12px;
  background: #fff;
  border-radius: 8px;
  font-size: 13px;
  display: flex;
  flex-direction: column;
  gap: 4px;
  min-width: 180px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.15);
}

.map-infowindow strong {
  font-weight: 600;
  color: #1a1a1a;
}

.map-infowindow span {
  color: #555;
  font-size: 12px;
}

.map-infowindow-distance {
  color: #2e7d32 !important;
  font-weight: 500 !important;
  font-size: 12px;
}

/* ===== 수거함 목록 ===== */
.bin-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
  max-height: 280px;
  overflow-y: auto;
}

.bin-list-empty,
.bin-list-status {
  padding: 20px;
  text-align: center;
  font-size: 14px;
  color: #757575;
  background: #fafafa;
  border-radius: 10px;
  border: 1px dashed #e0e0e0;
}

.bin-list-error {
  color: #c62828;
  background: #ffebee;
  border-color: #ef9a9a;
}

.bin-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 16px;
  background: #ffffff;
  border: 1px solid #e8e8e8;
  border-radius: 10px;
  cursor: pointer;
  transition: background-color 0.15s, border-color 0.15s;
}

.bin-item:hover {
  background-color: #f0faf0;
  border-color: #a5d6a7;
}

.bin-item.selected {
  background-color: #e8f5e9;
  border-color: #66bb6a;
}

.bin-item-icon {
  font-size: 18px;
  flex-shrink: 0;
}

.bin-item-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.bin-item-name {
  font-size: 14px;
  font-weight: 600;
  color: #1a1a1a;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.bin-item-address {
  font-size: 12px;
  color: #757575;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.bin-item-distance {
  font-size: 13px;
  font-weight: 500;
  color: #2e7d32;
  white-space: nowrap;
  flex-shrink: 0;
}

/* ===== 반응형 ===== */
@media (max-width: 1100px) {
  .guide-main-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 640px) {
  .guide-cards-grid {
    grid-template-columns: 1fr 1fr;
  }

  .guide-notice-banner {
    flex-direction: column;
    gap: 12px;
  }

  .guide-map-header {
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }
}

@media (max-width: 400px) {
  .guide-cards-grid {
    grid-template-columns: 1fr;
  }
}
