<%- include('../partials/header', {
  title: '회원가입',
  pageCss: 'signup'
}) %>

<div class="signup-page">
  <section class="left-section">
    <img
      src="/images/png/logo.png?v=5"
      alt="PillMate Logo"
      class="logo-image"
    >

    <p>
      우리집 약장 관리를<br>
      손쉽게 해보세요!
    </p>
  </section>

  <section class="right-section">
    <div class="signup-form">
      <h2>
        <a href="/auth/login" class="back-btn">‹</a>
        회원가입
      </h2>

      <form action="/auth/signup" method="POST" onsubmit="return validateSignupForm()">
        <div class="form-row">
          <label for="login_id">
            아이디 <span class="required">*</span>
          </label>

          <div class="id-wrapper">
            <div class="id-check-row">
              <input
                id="login_id"
                type="text"
                name="login_id"
                placeholder="아이디 입력(6~20자)"
                value="<%= formData?.login_id || '' %>"
                minlength="6"
                maxlength="20"
                required
                oninput="resetIdCheck()"
              >

              <button
                type="button"
                class="id-check-btn"
                onclick="checkLoginId()"
              >
                중복 확인
              </button>
            </div>

            <p id="idCheckMessage" class="id-check-message"></p>
          </div>
        </div>

        <div class="form-row">
          <label for="password">
            비밀번호 <span class="required">*</span>
          </label>

          <input
            id="password"
            type="password"
            name="password"
            placeholder="비밀번호 입력(영문, 숫자 포함 6~20자)"
            minlength="6"
            maxlength="20"
            required
          >
        </div>

        <div class="form-row">
          <label for="passwordConfirm">
            비밀번호 확인 <span class="required">*</span>
          </label>

          <input
            id="passwordConfirm"
            type="password"
            name="passwordConfirm"
            placeholder="비밀번호 재입력"
            minlength="6"
            maxlength="20"
            required
          >
        </div>

        <div class="form-row">
          <label for="name">
            이름 <span class="required">*</span>
          </label>

          <input
            id="name"
            type="text"
            name="name"
            placeholder="이름을 입력해주세요"
            value="<%= formData?.name || '' %>"
            required
          >
        </div>

        <div class="form-row">
          <label>성별(선택)</label>

          <div class="gender-group">
            <label class="gender-btn">
              <input
                type="radio"
                name="gender"
                value="남성"
                <%= formData?.gender === '남성' ? 'checked' : '' %>
              >
              <span>남자</span>
            </label>

            <label class="gender-btn">
              <input
                type="radio"
                name="gender"
                value="여성"
                <%= formData?.gender === '여성' ? 'checked' : '' %>
              >
              <span>여자</span>
            </label>
          </div>
        </div>

        <div class="form-row">
          <label for="birthYear">나이(선택)</label>

          <select id="birthYear" name="birthYear">
            <option value="">선택</option>

            <% for (let year = new Date().getFullYear(); year >= 1920; year--) { %>
              <option
                value="<%= year %>"
                <%= String(formData?.birthYear) === String(year) ? 'selected' : '' %>
              >
                <%= year %>
              </option>
            <% } %>
          </select>
        </div>

        <button type="submit" class="signup-btn">
          회원가입
        </button>
      </form>
    </div>
  </section>
</div>

<script>
  let isIdChecked = false;
  let checkedLoginId = "";

  function resetIdCheck() {
    isIdChecked = false;
    checkedLoginId = "";

    const message = document.getElementById("idCheckMessage");
    message.innerText = "";
    message.className = "id-check-message";
  }

  function checkLoginId() {
    const loginIdInput = document.getElementById("login_id");
    const message = document.getElementById("idCheckMessage");
    const loginId = loginIdInput.value.trim();
    const loginIdRegex = /^[A-Za-z0-9]{6,20}$/;

    isIdChecked = false;
    checkedLoginId = "";

    if (!loginId) {
      message.innerText = "아이디를 입력해주세요.";
      message.className = "id-check-message error";
      return;
    }

    if (!loginIdRegex.test(loginId)) {
      message.innerText = "아이디는 영문, 숫자 포함 6~20자로 입력해주세요.";
      message.className = "id-check-message error";
      return;
    }

    fetch(`/auth/check-id?login_id=${encodeURIComponent(loginId)}`)
      .then((res) => res.json())
      .then((data) => {
        message.innerText = data.message;
        message.className = data.available
          ? "id-check-message success"
          : "id-check-message error";

        if (data.available) {
          isIdChecked = true;
          checkedLoginId = loginId;
        }
      })
      .catch(() => {
        message.innerText = "중복 확인 중 오류가 발생했습니다.";
        message.className = "id-check-message error";
      });
  }

function validateSignupForm() {
  const loginId = document.getElementById("login_id").value.trim();
  const message = document.getElementById("idCheckMessage");

  const password = document.getElementById("password").value;
  const passwordConfirm = document.getElementById("passwordConfirm").value;

  if (!isIdChecked || checkedLoginId !== loginId) {
    message.innerText = "아이디 중복을 확인해주세요.";
    message.className = "id-check-message error";
    return false;
  }

  if (password !== passwordConfirm) {
    alert("비밀번호를 다시 확인해주세요.");
    return false;
  }

  return true;
}
</script>

<%- include('../partials/footer') %>