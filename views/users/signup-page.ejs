<%- include('../partials/header', {
  title: '회원가입',
  pageCss: 'signup'
}) %>

<div class="signup-page">
  <section class="left-section">
    <img
      src="/images/png/logo.png?v=5"
      alt="PillMate Logo"
      class="logo-image"
    >

    <p>
      우리집 약장 관리를<br>
      손쉽게 해보세요!
    </p>
  </section>

  <section class="right-section">
    <div class="signup-form">
      <h2>
        <a href="/auth/login" class="back-btn">‹</a>
        회원가입
      </h2>

      <form action="/auth/signup" method="POST">

        <% if (typeof error !== "undefined" && error) { %>
          <p class="error-message"><%= error %></p>
        <% } %>

        <div class="form-row">
          <label for="login_id">아이디</label>
          <input
            id="login_id"
            type="text"
            name="login_id"
            placeholder="아이디를 입력하세요"
            value="<%= formData?.login_id || '' %>"
            required
          >
        </div>

        <div class="form-row">
          <label for="password">비밀번호</label>
          <input
            id="password"
            type="password"
            name="password"
            placeholder="비밀번호를 입력하세요"
            required
          >
        </div>

        <div class="form-row">
          <label for="passwordConfirm">비밀번호 확인</label>
          <input
            id="passwordConfirm"
            type="password"
            name="passwordConfirm"
            placeholder="비밀번호를 다시 입력하세요"
            required
          >
        </div>

        <div class="form-row">
          <label for="name">이름</label>
          <input
            id="name"
            type="text"
            name="name"
            placeholder="이름을 입력하세요"
            value="<%= formData?.name || '' %>"
            required
          >
        </div>

        <div class="form-row">
          <label>성별(선택)</label>

          <div class="gender-group">
            <label class="gender-btn">
              <input
                type="radio"
                name="gender"
                value="남성"
                <%= formData?.gender === '남성' ? 'checked' : '' %>
              >
              <span>남자</span>
            </label>

            <label class="gender-btn">
              <input
                type="radio"
                name="gender"
                value="여성"
                <%= formData?.gender === '여성' ? 'checked' : '' %>
              >
              <span>여자</span>
            </label>
          </div>
        </div>

        <div class="form-row">
          <label for="birthYear">나이(선택)</label>

          <select id="birthYear" name="birthYear">
            <option value="">선택</option>

            <% for (let year = new Date().getFullYear(); year >= 1920; year--) { %>
              <option
                value="<%= year %>"
                <%= String(formData?.birthYear) === String(year) ? 'selected' : '' %>
              >
                <%= year %>
              </option>
            <% } %>
          </select>
        </div>

        <button type="submit" class="signup-btn">
          회원가입
        </button>
      </form>
    </div>
  </section>
</div>

<%- include('../partials/footer') %>