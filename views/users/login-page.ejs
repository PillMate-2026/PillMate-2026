<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>로그인</title>
  <link rel="stylesheet" href="/css/login.css?v=1600">
</head>

<body>
  <div class="login-page">
    <section class="left-section">
      <img src="/images/logo.png?v=4" alt="PillMate Logo" class="logo-image">

      <p>
        우리집 약장 관리를<br>
        손쉽게 해보세요!
      </p>
    </section>

    <section class="right-section">
      <div class="login-form">
        <h2>로그인</h2>

        <form action="/auth/login" method="POST">
          <label for="logoin_id">아이디</label>
          <input id="login_id" type="text" name="login_id" placeholder="아이디를 입력하세요" required>

          <label for="password">비밀번호</label>
          <input id="password" type="password" name="password" placeholder="비밀번호를 입력하세요" required>

          <button type="submit" class="login-btn">로그인</button>
        </form>

        <div class="divider">또는</div>

        <a href="/auth/google" class="google-link">
          <button type="button" class="google-btn">
            <img
              src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg"
              alt="google"
              class="google-logo"
            >
            <span>Google로 로그인</span>
          </button>
        </a>

        <div class="signup-link">
          <a href="/auth/signup">회원가입</a>
        </div>
      </div>
    </section>
  </div>
</body>
</html>