<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>회원가입</title>
  <link rel="stylesheet" href="/css/signup.css?v=1004">
</head>

<body>
  <div class="signup-page">
    <section class="left-section">
      <img
        src="/images/logo.png"
        alt="PillMate Logo"
        class="logo-image"
      />
      <p>
        우리집 약장 관리를<br>
        손쉽게 해보세요!
      </p>
    </section>

    <section class="right-section">
      <div class="signup-form">
        <h2>
          <a href="/auth/login" class="back-btn">‹</a>
          회원가입
        </h2>

        <form action="/auth/signup" method="POST">
          <div class="form-row">
            <label>아이디</label>
            <input type="email" name="email" required>
          </div>

          <div class="form-row">
            <label>비밀번호</label>
            <input type="password" name="password" required>
          </div>

          <div class="form-row">
            <label>비밀번호 확인</label>
            <input type="password" name="passwordConfirm" required>
          </div>

          <div class="form-row">
            <label>이름</label>
            <input type="text" name="name" required>
          </div>

          <div class="form-row">
            <label>성별(선택)</label>
            <div class="gender-group">
              <label class="gender-btn">
                <input type="radio" name="gender" value="남자">
                <span>남자</span>
              </label>

              <label class="gender-btn">
                <input type="radio" name="gender" value="여자">
                <span>여자</span>
              </label>
            </div>
          </div>

          <div class="form-row">
            <label>나이(선택)</label>
            <select name="birth_year">
              <% for (let year = 2026; year >= 1900; year--) { %>
                <option value="<%= year %>" <%= year === 1990 ? "selected" : "" %>>
                  <%= year %>
                </option>
              <% } %>
            </select>
          </div>

          <input type="hidden" name="birth_month" value="1">
          <input type="hidden" name="birth_day" value="1">

          <button type="submit" class="signup-btn">
            회원가입
          </button>
        </form>
      </div>
    </section>
  </div>
</body>
</html>