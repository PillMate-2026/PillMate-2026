<aside class="app-sidebar">
  <div class="sidebar-user">
    <%
      const sidebarUser = locals.user || { name: 'user', gender: null };
      let avatarSrc;

      if (sidebarUser.gender === '\uC5EC\uC131') {
        avatarSrc = '/images/icons/female.svg';
      } else if (sidebarUser.gender === '\uB0A8\uC131') {
        avatarSrc = '/images/icons/male.svg';
      } else {
        avatarSrc = '/images/icons/profile.svg';
      }
    %>
    <img src="<%= avatarSrc %>" alt="profile" class="sidebar-avatar">
    <span class="sidebar-username"><%= sidebarUser.name %></span>
  </div>

  <div class="sidebar-logo">
    <span class="logo-pill">Pill</span>
    <span class="logo-mate">Mate</span>
  </div>

  <nav class="sidebar-nav">
    <a href="/dashboard" class="sidebar-link <%= locals.activeMenu === 'home' ? 'active' : '' %>">
      <img src="/images/icons/home.svg" alt="홈" class="sidebar-icon">
      <span>홈</span>
    </a>
    <a href="/medicines/add" class="sidebar-link <%= locals.activeMenu === 'add' ? 'active' : '' %>">
      <img src="/images/icons/plus.svg" alt="약 등록하기" class="sidebar-icon">
      <span>약 등록하기</span>
    </a>
    <a href="/family" class="sidebar-link <%= locals.activeMenu === 'family' ? 'active' : '' %>">
      <img src="/images/icons/people.svg" alt="가족 그룹" class="sidebar-icon">
      <span>가족 그룹</span>
    </a>
    <a href="/guide" class="sidebar-link <%= locals.activeMenu === 'guide' ? 'active' : '' %>">
      <img src="/images/icons/pill.svg" alt="복약가이드 AI" class="sidebar-icon">
      <span>복약가이드 AI</span>
    </a>
    <a href="/disposal-guide" class="sidebar-link <%= locals.activeMenu === 'disposal-guide' ? 'active' : '' %>">
      <img src="/images/icons/map.svg" alt="폐기가이드" class="sidebar-icon">
      <span>폐기가이드</span>
    </a>
  </nav>
</aside>
