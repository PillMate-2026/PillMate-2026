<%- include('partials/header', {
  title: title,
  pageCss: 'guide'
}) %>

<div class="app-layout">
  <%- include('partials/sidebar', { activeMenu: 'disposal-guide' }) %>
 
    <!-- 상단바 -->
    <div class="app-main">
    <%- include('partials/topbar', {
      pageTitle: '폐기가이드',
      pageDesc: '집에 남은 약은 일반 쓰레기나 하수구에 버리지 말고, 올바른 방법으로 폐기해 주세요',
      pageIcon: '/images/icons/map.svg',
      showNotification: false
    }) %>

    <!-- 메인 -->
    <main class="app-content">

      <!-- 안내 배너 -->
      <div class="guide-banner">

        <div class="guide-banner-icon">

          <svg width="44" height="44" viewBox="0 0 44 44" fill="none">

            <rect
              width="44"
              height="44"
              rx="10"
              fill="#e8f5e9"
            />

            <path
              d="M22 10a4 4 0 1 1 0 8 4 4 0 0 1 0-8z"
              fill="#2e7d32"
            />

            <path
              d="M14 34c0-6 4-10 8-10s8 4 8 10"
              stroke="#2e7d32"
              stroke-width="2"
              stroke-linecap="round"
            />

            <rect
              x="28"
              y="24"
              width="8"
              height="10"
              rx="2"
              fill="#2e7d32"
            />

            <path
              d="M27 26h10"
              stroke="#fff"
              stroke-width="1.5"
            />

          </svg>

        </div>

        <div class="guide-banner-text">

          <strong>
            폐의약품은 약국/보건소 수거함에 버려야 해요
          </strong>

          <p>
            ◎약을 변기나 싱크대에 버리면 환경오염이 발생할 수 있어요
          </p>

          <p>
            ◎일반 쓰레기로 버리면 어린이나 반려동물이
            실수로 먹을 위험이 있어요
          </p>

          <p>
            ◎가까운 약국, 보건소, 행정복지센터의
            폐의약품 수거함을 이용해요
          </p>

        </div>

      </div>

      <!-- 메인 그리드 -->
      <div class="guide-grid">

        <!-- 왼쪽 -->
        <div class="guide-left">

          <h2 class="guide-section-title">
            약 종류별 폐기 방법
          </h2>

          <div class="guide-cards">

            <% guides.forEach(function(g) { %>

              <div class="guide-card">

                <div class="guide-card-label">
                  <%= g.type %>
                </div>

                <img
                  src="<%= g.imgFile %>"
                  alt="<%= g.type %>"
                  class="guide-card-img-real"
                >

                <p class="guide-card-desc">
                  <%= g.guide %>
                </p>

                <% if (g.detail) { %>
                  <p class="guide-card-detail">
                    <%= g.detail %>
                  </p>
                <% } %>

              </div>

            <% }) %>

          </div>

        </div>

        <!-- 오른쪽 -->
        <div class="guide-right">

          <div class="guide-map-header">

            <h2 class="guide-section-title">
              폐의약품 수거함 찾기
            </h2>

            <button
              id="btn-find-location"
              class="btn-find-location"
              type="button"
            >

              <svg width="16" height="16" viewBox="0 0 24 24" fill="none">

                <circle
                  cx="12"
                  cy="12"
                  r="3"
                  stroke="white"
                  stroke-width="2"
                />

                <path
                  d="M12 2v3M12 19v3M2 12h3M19 12h3"
                  stroke="white"
                  stroke-width="2"
                  stroke-linecap="round"
                />

              </svg>

              내 위치로 찾기

            </button>

          </div>

          <!-- 카카오맵 -->
          <div
            id="kakao-map"
            class="guide-map"
            style="width:100%; height:300px;"
          ></div>

          <!-- 수거함 목록 -->
          <div id="bin-list" class="bin-list">

            <div class="bin-list-empty">
              <p>
                📍 '내 위치로 찾기' 버튼을 눌러
                가까운 수거함을 확인하세요
              </p>
            </div>

          </div>

        </div>

      </div>


      </div>
    </main>

  </div>

</div>

<!-- 카카오맵 SDK -->
<% if (typeof kakaoMapKey !== 'undefined' && kakaoMapKey) { %>

  <script
    src="https://dapi.kakao.com/v2/maps/sdk.js?appkey=<%= kakaoMapKey %>&autoload=false&libraries=services">
  </script>

<% } else { %>

  <script>
    window.KAKAO_MAP_UNAVAILABLE = true;
  </script>

<% } %>

<!-- guide.js -->

<script src="/js/guide.js"></script>
<%- include('partials/footer') %>

