<%- include('partials/header', {
  title: '챗봇',
  pageCss: 'chatbot'
}) %>

<div class="app-layout chatbot-shell">
  <%- include('partials/sidebar', { activeMenu: 'guide', user: typeof user !== 'undefined' ? user : null }) %>

  <div class="app-main">
    <%- include('partials/topbar', {
      pageTitle: 'AI 복약 도우미',
      pageDesc: '증상을 입력하면 내 약장에서 관련 약과 복용 정보를 알려드립니다',
      pageIcon: '/images/icons/pill.svg'
    }) %>

    <main class="app-content chatbot-content">
      <div class="chatbot-page">
        <h2>PillMate AI</h2>

        <div id="chatMessages" class="chat-messages">
          <div class="bot-message">
            안녕하세요! 증상을 입력하면 내 약장에서 관련 약을 찾아드릴게요.
            <br>
            예: 두통이 있고 열이 나요
          </div>
        </div>

        <div class="chat-input-area">
          <input 
            type="text" 
            id="chatInput" 
            placeholder="증상을 입력하세요"
          >
          <button type="button" onclick="sendChatMessage()">전송</button>
        </div>
      </div>
    </main>
  </div>
</div>

<script src="/js/chatbot.js"></script>
<%- include('partials/footer') %>