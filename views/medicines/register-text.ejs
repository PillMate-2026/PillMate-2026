<%- include('../partials/header', {
  title: '약 등록하기',
  pageCss: 'medicine'
}) %>

<div class="app-layout">
  <%- include('../partials/sidebar', { activeMenu: 'add' }) %>

  <div class="app-main">
    <%- include('../partials/topbar', {
      pageTitle: '약 등록하기',
      pageDesc: '약장에 의약품을 추가합니다',
      pageIcon: '/images/icons/plus.svg',
      showNotification: false
    }) %>

    <main class="app-content">

      <section class="text-register-container">

        <form
          class="medicine-form"
          action="/medicines/register"
          method="POST"
        >

          <div class="form-group">
            <label for="medicineName">의약품 이름</label>
            <input
              type="text"
              id="medicineName"
              name="medicineName"
              class="form-input"
              value="<%= medicineName || '' %>"
            >
            <div id="autocompleteList"></div>
            <script>

            document
              .getElementById('medicineName')
              .addEventListener('input', async (event) => {

                const keyword = event.target.value;

                if (keyword.length < 2) {

                  document.getElementById(
                    'autocompleteList'
                  ).innerHTML = '';

                  return;
                }

                const response =
                  await fetch(
                    `/medicines/autocomplete?keyword=${keyword}`
                  );

                const medicines =
                  await response.json();

                const list =
                  document.getElementById(
                    'autocompleteList'
                  );

                list.innerHTML = '';

                medicines.forEach(item => {

                  list.innerHTML += `
                    <div
                      class="autocomplete-item"
                      data-name="${item.itemName}"
                    >
                      ${item.itemName}
                    </div>
                  `;

                });
                document
                  .querySelectorAll('.autocomplete-item')
                  .forEach(item => {

                    item.addEventListener('click', () => {

                      document.getElementById(
                        'medicineName'
                      ).value =
                        item.dataset.name;

                      document.getElementById(
                        'autocompleteList'
                      ).innerHTML = '';

                    });

                  });

              });
            </script>
            <% if (medicineCandidates.length > 0) { %>

              <div class="medicine-candidates">

                <% medicineCandidates.forEach(item => { %>

                  <button
                    type="button"
                    class="candidate-item"
                    data-name="<%= item.itemName %>"
                  >
                    <%= item.itemName %>
                  </button>

                <% }) %>

              </div>

            <% } %>
          </div>


          <div class="form-group">
            <label for="expiryDate">유통기한</label>
            <input
              type="date"
              id="expiryDate"
              name="expiryDate"
              class="form-input"
            >
          </div>

          <div class="autocomplete-guide">
            ⓘ 외부 API를 통한 자동완성을 지원합니다.
            약 이름을 2자 이상 입력하면 후보가 표시됩니다.
          </div>

          <div class="button-group">

            <button
              type="button"
              class="cancel-btn"
              onclick="history.back()"
            >
              취소하기
            </button>

            <button
              type="submit"
              class="save-btn"
            >
              약장에 등록하기
            </button>

          </div>

        </form>

      </section>

    </main>

  </div>
</div>

<script>

  document
    .querySelectorAll('.candidate-item')
    .forEach(button => {

      button.addEventListener('click', () => {

        document.getElementById(
          'medicineName'
        ).value =
          button.dataset.name;

      });

    });

</script>

<%- include('../partials/footer') %>
