<%- include('../partials/header', {
  title: '약 등록하기',
  pageCss: 'medicine'
}) %>

  <div class="app-layout">
     <%- include('../partials/sidebar', { activeMenu: 'add' }) %>
      
      <div class="app-main">
          <%- include('../partials/topbar', {
            pageTitle: '약 등록하기',
            pageDesc: '약장에 의약품을 추가합니다',
            pageIcon: '/images/icons/plus.svg',
            showNotification: false
          }) %>


    <main class="app-content">

    <section class="ocr-register-container">

    <form
    action="/medicines/ocr"
    method="POST"
    enctype="multipart/form-data"
    >

    <div
      id="uploadBox"
      class="upload-box"
    >
        <p
          id="uploadGuide"
          class="upload-guide"
        >
        '파일 선택' 버튼을 클릭하거나, 사진을 드래그하여<br>
        의약품 이름이 적힌 포장지 또는 제품 사진을 업로드하세요.<br>
        (제품명이 선명할수록 인식률이 높아집니다.)
        </p>

        <input
        type="file"
        id="medicineImage"
        name="medicineImage"
        accept="image/*"
        hidden
        >

        <button
          id="fileSelectBtn"
          type="button"
          class="file-select-btn"
          onclick="document.getElementById('medicineImage').click()"
        >
        파일 선택
        </button>

        <img
        id="previewImage"
        class="preview-image"
        style="display:none"
        >

    </div>

    <button
        type="submit"
        class="register-btn"
    >
        OCR 등록하기
    </button>

    </form>

    <button
        class="manual-btn"
        onclick="location.href='/medicines/manual'"
    >
        텍스트로 약 등록하기
    </button>

  </section>

</main>

  </div>
</div>

<script>
const imageInput = document.getElementById('medicineImage');
const previewImage = document.getElementById('previewImage');

const uploadBox =
  document.getElementById('uploadBox');

uploadBox.addEventListener(
  'dragover',
  (event) => {

    event.preventDefault();

    uploadBox.classList.add(
      'drag-over'
    );

  }
);
uploadBox.addEventListener(
  'dragleave',
  () => {

    uploadBox.classList.remove(
      'drag-over'
    );

  }
);
uploadBox.addEventListener(
  'drop',
  (event) => {

    event.preventDefault();

    uploadBox.classList.remove(
      'drag-over'
    );

    const file =
      event.dataTransfer.files[0];

    if (!file) return;

    imageInput.files =
      event.dataTransfer.files;

    const imageUrl =
      URL.createObjectURL(file);

    previewImage.src = imageUrl;
    previewImage.style.display = 'block';

    document
      .getElementById('uploadGuide')
      .style.display = 'none';

    document
      .getElementById('fileSelectBtn')
      .style.display = 'none';

  }
);

imageInput.addEventListener('change', (event) => {
  const file = event.target.files[0];

  if (!file) return;

  const imageUrl = URL.createObjectURL(file);

  previewImage.src = imageUrl;
  previewImage.style.display = 'block';

  document
    .getElementById('uploadGuide')
    .style.display = 'none';

  document
    .getElementById('fileSelectBtn')
    .style.display = 'none';

   const uploadBox =
      document.getElementById('uploadBox');

    uploadBox.addEventListener(
      'dragover',
      (event) => {

        event.preventDefault();

        uploadBox.classList.add(
          'drag-over'
        );

      }
    );

    uploadBox.addEventListener(
      'dragleave',
      () => {

        uploadBox.classList.remove(
          'drag-over'
        );

      }
    );

    uploadBox.addEventListener(
      'drop',
      (event) => {

        event.preventDefault();

        uploadBox.classList.remove(
          'drag-over'
        );

        const file =
          event.dataTransfer.files[0];

        if (!file) return;

        imageInput.files =
          event.dataTransfer.files;

        const imageUrl =
          URL.createObjectURL(file);

        previewImage.src = imageUrl;
        previewImage.style.display = 'block';

        document
          .getElementById('uploadGuide')
          .style.display = 'none';

        document
          .getElementById('fileSelectBtn')
          .style.display = 'none';

      }
    );
});
</script>

<%- include('../partials/footer') %>
