<%- include('partials/header') %>
<link rel="stylesheet" href="/css/medicineDetail.css">

<div class="app-wrapper">
  <%- include('partials/sidebar', { activeMenu: 'home' }) %>

  <div class="app-main">
    <main class="app-content">
      <button type="button" onclick="openMedicineDetailModal()">임시 약 카드</button>

  <!--모달-->
  <div id="medicineDetailModal" class="medicine-modal">
    <div class="medicine-modal-box">

      <div class="medicine-modal-header">
        <h4>약 상세정보</h4>
        <button type="button" class="medicine-modal-close" onclick="closeMedicineDetailModal()">
          ×
        </button>
      </div>

      <div class="medicine-modal-content">
        <div class="medicine-image-box">
          <img src="/images/logo2.png" alt="약 이미지" class="medicine-image" id ="modalMedicineImage">
        </div>

        <div class="medicine-summary-card">
          <div class="medicine-summary-name" id="modalMedicineName"></div>
          
          <div class="medicine-summary-body">
            <div class="medicine-status-area">
              <span class="status-badge usable" id="modalUsableStatus">복용 가능</span>
              <span class="status-badge expired" id="modalExpiredStatus">폐기 필요</span>
            </div>

            <div class="medicine-info-grid">
              <div class="medicine-info-box">
                <span>주성분</span>
                <strong id="modalIngredient">정보 없음</strong>
              </div>

              <div class="medicine-info-box">
                <span>등록일자</span>
                <strong id="modalCreatedAt">2026-05-11</strong>
              </div>

              <div class="medicine-info-box">
                <span>업체명</span>
                <strong id="modalEntpName">정보 없음</strong>
              </div>

              <div class="medicine-info-box">
                <span>유통기한</span>
                <strong id="modalExpirationDate">2027-03-01</strong>
              </div>
            </div>
          </div>
        </div>
        
        <div class="medicine-section">
          <div class="medicine-section-title">효능 효과</div>
            <div class="medicine-section-text" id="modalEfficacy">
            </div>
        </div>

        <div class="medicine-section">
          <div class="medicine-section-title">복용방법</div>
            <div class="medicine-section-text" id="modalUseMethod">
            </div>
        </div>

        <div class="medicine-section">
          <div class="medicine-section-title">주의사항</div>
            <div class="medicine-section-text" id="modalPrecaution">
            </div>
        </div>

        <div class="medicine-section">
          <div class="medicine-section-title">상호작용</div>
            <div class="medicine-section-text" id="modalInteraction">
            </div>
        </div>

        <div class="medicine-section">
          <div class="medicine-section-title">부작용</div>
            <div class="medicine-section-text" id="modalSideEffect">
            </div>
        </div>
      </div>

      <div class="medicine-modal-footer">
        <button type="button" onclick="openEditExpirationModal()">수정하기</button>
        <button type="button" onclick="openDisposalGuide()">폐기 안내 보러가기</button>
        <button type="button" onclick="openDeleteConfirm()">삭제하기</button>
      </div>
    
    </div>
  </div>

  <script src="/js/medicineDetail.js"></script>
    </main>
  </div>
</div>

<%- include('partials/footer') %>