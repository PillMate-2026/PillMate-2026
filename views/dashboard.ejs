<%- include('partials/header') %>
<link rel="stylesheet" href="/css/dashboard.css" />

<div class="app-wrapper dashboard-shell">
  <%- include('partials/sidebar', { activeMenu: 'home', user: typeof user !== 'undefined' ? user : null }) %>

  <div class="app-main">
    <main class="app-content dashboard-content">
      <section class="dashboard-summary" aria-label="약장 요약">
        <div class="summary-row">
          <div class="summary-card summary-total">
            <span>전체 약</span>
            <strong><%= total %>개</strong>
          </div>
          <div class="summary-card summary-normal">
            <span>유효 약</span>
            <strong><%= normalCount %>개</strong>
          </div>
          <div class="summary-card summary-expired">
            <span>만료 약</span>
            <strong><%= expiredCount %>개</strong>
          </div>
        </div>
      </section>

      <form class="dashboard-controls" method="get" action="/dashboard">
        <input type="hidden" name="userId" value="<%= userId %>">
        <input type="hidden" name="status" value="<%= status %>">

        <label class="search-box">
          <span class="search-icon">⌕</span>
          <input type="search" name="keyword" value="<%= search %>" aria-label="약 검색">
        </label>

        <div class="control-group">
          <span>상태</span>
          <a href="?userId=<%= userId %>&status=<%= status === 'normal' ? 'all' : 'normal' %>&sort=<%= sort %>&keyword=<%= encodeURIComponent(search) %>"
            class="filter-btn <%= status === 'normal' ? 'active' : '' %>">
            유효
          </a>
          <a href="?userId=<%= userId %>&status=<%= status === 'expired' ? 'all' : 'expired' %>&sort=<%= sort %>&keyword=<%= encodeURIComponent(search) %>"
            class="filter-btn <%= status === 'expired' ? 'active' : '' %>">
            만료
          </a>
        </div>

        <label class="sort-select">
          <span>정렬</span>
          <select name="sort" onchange="this.form.submit()">
            <option value="expiry" <%= sort === 'expiry' ? 'selected' : '' %>>유통기한 임박순</option>
            <option value="created" <%= sort === 'created' ? 'selected' : '' %>>최신 등록순</option>
          </select>
        </label>
      </form>

      <% if (medicines && medicines.length > 0) { %>
        <section class="medicine-card-grid" aria-label="약 목록">
          <% medicines.forEach((medicine) => { %>
            <% const isExpired = medicine.days_left < 0; %>
            <article class="medicine-card <%= isExpired ? 'expired' : 'valid' %>">
              <div class="medicine-card-top">
                <div class="medicine-image-placeholder"></div>
                <div class="medicine-main-info">
                  <h2><%= medicine.name %></h2>
                  <% if (isExpired) { %>
                    <span class="status-pill expired">만료</span>
                  <% } else { %>
                    <span class="status-pill valid">D - <%= medicine.days_left %></span>
                  <% } %>
                </div>
              </div>
              <div class="medicine-meta">
                <p>주성분</p>
                <p>유통기한 <%= medicine.expiration_date || '-' %></p>
              </div>
            </article>
          <% }) %>
        </section>
      <% } else { %>
        <p class="empty-message"><%= search ? '검색 결과가 없습니다.' : '조회된 약이 없습니다.' %></p>
      <% } %>
    </main>
  </div>
</div>

<%- include('partials/footer') %>
