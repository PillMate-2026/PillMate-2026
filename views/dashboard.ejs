<%- include('partials/header') %>
<link rel="stylesheet" href="/css/dashboard.css" />
<link rel="stylesheet" href="/css/medicineDetail.css">

<div class="app-wrapper dashboard-shell">
  <%- include('partials/sidebar', { activeMenu: 'home' }) %>

  <div class="app-main">
    <main class="app-content dashboard-content">
      <section class="dashboard-summary" aria-label="약장 요약">
        <div class="summary-card summary-total">
          <span>전체 약</span>
          <strong><%= total %>개</strong>
        </div>
      </section>

      <form class="dashboard-controls" method="get" action="/dashboard">
        <input type="hidden" name="scope" value="<%= scope %>">
        <input type="hidden" name="status" value="<%= status %>">

        <label class="search-box">
          <span class="search-icon">⌕</span>
          <input type="search" name="search" value="<%= search %>" aria-label="약 검색">
        </label>

        <div class="control-group">
          <span>상태</span>
          <a href="?userId=<%= userId %>&scope=<%= scope %>&status=<%= status === 'normal' ? 'all' : 'normal' %>&sort=<%= sort %>&search=<%= search %>"
            class="filter-btn <%= status === 'normal' ? 'active' : '' %>">
          유효
          </a>
          <a href="?userId=<%= userId %>&scope=<%= scope %>&status=<%= status === 'expired' ? 'all' : 'expired' %>&sort=<%= sort %>&search=<%= search %>"
            class="filter-btn <%= status === 'expired' ? 'active' : '' %>">
          만료
          </a>
        </div>

        <label class="sort-select">
          <span>정렬</span>
          <select name="sort" onchange="this.form.submit()">
            <option value="expiry" <%= sort === 'expiry' ? 'selected' : '' %>>유통기한 임박순</option>
            <option value="name" <%= sort === 'name' ? 'selected' : '' %>>이름순</option>
          </select>
        </label>
      </form>

      <% if (scope === 'family' && !familyId) { %>
        <p class="empty-message">연결된 가족 그룹이 없습니다.</p>
      <% } else if (medicines && medicines.length > 0) { %>
        <section class="medicine-card-grid" aria-label="약 목록">
          <% medicines.forEach((medicine) => { %>
            <% const isExpired = medicine.days_left < 0; %>
            <article class="medicine-card <%= isExpired ? 'expired' : 'valid' %>" onclick="openMedicineDetailModal(<%= medicine.medicine_id %>)">
              <div class="medicine-card-top">
                <div class="medicine-image-placeholder"></div>
                <div class="medicine-main-info">
                  <h2><%= medicine.name %></h2>
                  <p><%= medicine.use_method || '복용 정보 없음' %></p>
                  <% if (isExpired) { %>
                    <span class="status-pill expired">만료</span>
                  <% } else { %>
                    <span class="status-pill valid">D - <%= medicine.days_left %></span>
                  <% } %>
                </div>
              </div>
              <div class="medicine-meta">
                <p>주성분</p>
                <p>유통기한 <%= medicine.expiration_date || '-' %></p>
              </div>
            </article>
          <% }) %>
        </section>
      <% } else { %>
        <p class="empty-message">조회된 약이 없습니다.</p>
      <% } %>

      <!--모달-->
  <div id="medicineDetailModal" class="medicine-modal">
    <div class="medicine-modal-box">

      <div class="medicine-modal-header">
        <h4>약 상세정보</h4>
        <button type="button" class="medicine-modal-close" onclick="closeMedicineDetailModal()">
          ×
        </button>
      </div>

      <div class="medicine-modal-content">
        <div class="medicine-image-box">
          <img src="/images/logo2.png" alt="약 이미지" class="medicine-image" id ="modalMedicineImage">
        </div>

        <div class="medicine-summary-card">
          <div class="medicine-summary-name" id="modalMedicineName"></div>
          
          <div class="medicine-summary-body">
            <div class="medicine-status-area">
              <span class="status-badge" id="modalStatusBadge"></span>
            </div>

            <div class="medicine-info-grid">
              <div class="medicine-info-box">
                <span>주성분</span>
                <strong id="modalIngredient">정보 없음</strong>
              </div>

              <div class="medicine-info-box">
                <span>등록일자</span>
                <strong id="modalCreatedAt">2026-05-11</strong>
              </div>

              <div class="medicine-info-box">
                <span>업체명</span>
                <strong id="modalEntpName">정보 없음</strong>
              </div>

              <div class="medicine-info-box">
                <span>유통기한</span>
                <strong id="modalExpirationDate">2027-03-01</strong>
              </div>
            </div>
          </div>
        </div>
        
        <div class="medicine-section">
          <div class="medicine-section-title">효능 효과</div>
            <div class="medicine-section-text" id="modalEfficacy">
            </div>
        </div>

        <div class="medicine-section">
          <div class="medicine-section-title">복용방법</div>
            <div class="medicine-section-text" id="modalUseMethod">
            </div>
        </div>

        <div class="medicine-section">
          <div class="medicine-section-title">주의사항</div>
            <div class="medicine-section-text" id="modalPrecaution">
            </div>
        </div>

        <div class="medicine-section">
          <div class="medicine-section-title">상호작용</div>
            <div class="medicine-section-text" id="modalInteraction">
            </div>
        </div>

        <div class="medicine-section">
          <div class="medicine-section-title">부작용</div>
            <div class="medicine-section-text" id="modalSideEffect">
            </div>
        </div>
      </div>

      <div class="medicine-modal-footer">
        <button type="button" onclick="openEditExpirationModal()">수정하기</button>
        <button type="button" onclick="openDisposalGuide()">폐기 안내 보러가기</button>
        <button type="button" onclick="openDeleteConfirm()">삭제하기</button>
      </div>
    </div>
  </div>

    </main>
  </div>
</div>

<script src="/js/medicineDetail.js"></script>

<%- include('partials/footer') %>
